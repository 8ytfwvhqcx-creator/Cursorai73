BLOCK:Script
INTERPRETER:NodeJS
INPUT CK, CS, RT_URL, UA
BEGIN SCRIPT
const crypto = require('crypto');
const http = require('http');
function bridgeExec(payload) {
  return new Promise(function (resolve, reject) {
    var data = JSON.stringify(payload);
    var req = http.request({
      hostname: '127.0.0.1',
      port: 18765,
      path: '/exec',
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(data, 'utf8') }
    }, function (res) {
      var chunks = [];
      res.on('data', function (c) { chunks.push(c); });
      res.on('end', function () {
        resolve({ code: res.statusCode, text: Buffer.concat(chunks).toString('utf8') });
      });
    });
    req.on('error', reject);
    req.write(data);
    req.end();
  });
}
function percentEncode(str) {
  const buf = Buffer.from(String(str), 'utf8');
  let o = '';
  for (let i = 0; i < buf.length; i++) {
    const b = buf[i];
    if ((b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b === 45 || b === 46 || b === 95 || b === 126)
      o += String.fromCharCode(b);
    else
      o += '%' + b.toString(16).toUpperCase().padStart(2, '0');
  }
  return o;
}
function formBodyOrdered(pairs) {
  return pairs.map(function (p) { return percentEncode(p[0]) + '=' + percentEncode(String(p[1])); }).join('&');
}
function buildOAuthHeader(method, url, consumerKey, consumerSecret, token, tokenSecret, extra) {
  const oauth = {
    oauth_consumer_key: String(consumerKey),
    oauth_nonce: crypto.randomBytes(16).toString('hex'),
    oauth_signature_method: 'HMAC-SHA1',
    oauth_timestamp: String(Math.floor(Date.now() / 1000)),
    oauth_version: '1.0'
  };
  if (token !== null && token !== undefined && String(token) !== '') oauth.oauth_token = String(token);
  const sigParams = Object.assign({}, oauth, extra || {});
  const enc = [];
  for (const k of Object.keys(sigParams)) enc.push([percentEncode(k), percentEncode(String(sigParams[k]))]);
  enc.sort((a, b) => {
    const c = a[0].localeCompare(b[0]);
    if (c !== 0) return c;
    return a[1].localeCompare(b[1]);
  });
  const paramString = enc.map(([k, v]) => k + '=' + v).join('&');
  const baseString = [method.toUpperCase(), percentEncode(url), percentEncode(paramString)].join('&');
  const signingKey = percentEncode(consumerSecret) + '&' + percentEncode(tokenSecret);
  const sig = crypto.createHmac('sha1', Buffer.from(signingKey, 'utf8')).update(Buffer.from(baseString, 'utf8')).digest('base64');
  oauth.oauth_signature = sig;
  const parts = [];
  parts.push('oauth_consumer_key="' + percentEncode(oauth.oauth_consumer_key) + '"');
  parts.push('oauth_nonce="' + percentEncode(oauth.oauth_nonce) + '"');
  parts.push('oauth_signature_method="' + percentEncode(oauth.oauth_signature_method) + '"');
  parts.push('oauth_timestamp="' + percentEncode(oauth.oauth_timestamp) + '"');
  parts.push('oauth_version="' + percentEncode(oauth.oauth_version) + '"');
  if (oauth.oauth_token !== undefined) parts.push('oauth_token="' + percentEncode(oauth.oauth_token) + '"');
  parts.push('oauth_signature="' + percentEncode(oauth.oauth_signature) + '"');
  return 'OAuth ' + parts.join(', ');
}
var realm = String(RT_URL);
var extra = { realm: realm };
var rtBody = formBodyOrdered([['realm', realm]]);
var rtAuth = buildOAuthHeader('POST', String(RT_URL), String(CK), String(CS), '', '', extra);
var uaStr = String(UA);
var hdrs = {
  'Accept': 'application/json',
  'Accept-Charset': 'UTF-8',
  'Accept-Encoding': 'gzip, deflate, br',
  'Accept-Language': 'fr-FR,fr;q=0.9',
  'Connection': 'keep-alive',
  'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
  'User-Agent': uaStr,
  'X-CLIENT-VERSION': '26.1.5',
  'Origin': 'https://mobile.poulpeo.com',
  'Referer': 'https://mobile.poulpeo.com/',
  'Authorization': rtAuth
};
var br = await bridgeExec({ method: 'POST', url: String(RT_URL), headers: hdrs, body: rtBody });
var RT_STATUS;
var RT_RESPONSE;
try {
  var jr = JSON.parse(br.text);
  RT_STATUS = String(jr.status != null ? jr.status : br.code);
  RT_RESPONSE = String(jr.text != null ? jr.text : '');
} catch (e1) {
  RT_STATUS = String(br.code);
  RT_RESPONSE = br.text;
}
END SCRIPT
OUTPUT String @RT_STATUS
OUTPUT String @RT_RESPONSE
ENDBLOCK

BLOCK:Keycheck
  banIfNoMatch = False
  KEYCHAIN FAIL OR
    STRINGKEY @RT_RESPONSE Contains "Cloudflare"
    STRINGKEY @RT_RESPONSE Contains "Sorry, you have been blocked"
  KEYCHAIN SUCCESS OR
    STRINGKEY @RT_STATUS EqualTo "200"
  KEYCHAIN FAIL OR
    STRINGKEY @RT_STATUS DoesNotContain "200"
ENDBLOCK

